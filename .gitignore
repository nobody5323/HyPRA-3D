# ===== 密钥与本地配置（红线：一律不入库）=====
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
secrets/

# ===== Python 后端 =====
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ===== 前端 Next.js =====
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# ===== 桌面端 Electron =====
# 安装包与免安装产物（体积大，且可能混入本地模型/密钥），不入库
desktop/release/
# 构建时生成的应用图标（由 scripts/make-app-icon.mjs 产出）
desktop/assets/
# 本地模型与 Cubism SDK（桌宠渲染资源，自备且不可自由分发）
desktop/public/live2d/
desktop/public/vendor/cubism/

# ===== 数据与媒体产物（勿提交）=====
# 本地向量/数据库文件与生成的视频语音体积大且含隐私，一律不入库
*.db
*.sqlite
qdrant_storage/
backend/data/
media/
*.mp4
*.mp3
*.wav

# ===== 本地私有资料（自备 SDK/模型包、开发留档、旧备份、生成缓存）=====
# 与源码无关但需要留在本机的文件统一放这里，保证根目录只出现项目本身
_local/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===== pi 本地会话记录（含对话隐私，不提交）=====
.pi-web/

# ===== 里程碑总结留档（本地开发过程记录，不入库）=====
summaries/

# ---- Live2D / Cubism SDK 与模型（自备资源，不入库）----
# Cubism SDK for Web（Core + Framework + Shaders）由 scripts/setup-cubism.mjs 落位
frontend/vendor/cubism/
frontend/public/vendor/cubism/
# 模型资源：只有能自由分发的才可放开例外
frontend/public/live2d/
*.moc3
*.model3.json
*.physics3.json
*.pose3.json
*.cdi3.json
*.exp3.json
*.motion3.json

# 自备资源压缩包（Live2D SDK / 模型包等一律不入库）
*.zip
