# ===== 密钥与本地配置（红线：一律不入库）=====
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
secrets/

# ===== Python 后端 =====
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ===== 前端 Next.js =====
node_modules/
.next/
out/
# 随桌面端分发的 Web 端静态产物（由 scripts/build-web-bundle.mjs 组装，构建产物不入库）
frontend/out-web/
dist/
build/
*.tsbuildinfo

# ===== 桌面端 Electron =====
# 安装包与免安装产物（体积大，且可能混入本地模型/密钥），不入库
desktop/release/
# 备用输出目录：release/ 被正在运行的实例锁住时用它打包（见 README 排障）
desktop/release-new/
# 验证性打包的临时输出目录（同上，用完即可删）
desktop/release-verify/
# 构建时生成的应用图标（由 scripts/make-app-icon.mjs 产出）
desktop/assets/
# 本地模型与 Cubism SDK（桌宠渲染资源，自备且不可自由分发）
desktop/public/live2d/
desktop/public/vendor/cubism/

# ===== 数据与媒体产物（勿提交）=====
# 本地向量/数据库文件与生成的视频语音体积大且含隐私，一律不入库
*.db
*.sqlite
qdrant_storage/
backend/data/
# 根目录 data/：开发形态下运行时可能落在这里（如 data/logs/），
# 属可写数据，不入库（仅锚定仓库根，不影响 backend/data）
/data/
media/
*.mp4
*.mp3
*.wav

# ===== 感知层：行踪数据（隐私红线，绝不可入库）=====
# `timeline.py` 经 `data_path("perception")` 落在 `data_root()/perception`，
# 开发形态下即 `backend/perception/`（**不是** backend/data/，见 §4.9）。
# 内容是「几点到几点在用什么程序」的用户行踪，属个人隐私数据。
backend/perception/

# ===== 工作区工具数据（非项目产物）=====
.workbuddy-ai/

# ===== 审查报告（内部分析产物，不入库）=====
*审查报告*.md
*优化评估报告*.md

# ===== 感知层：ASR 模型权重（绝不可入库）=====
# 模型不可自由分发（AGENTS.md §6），且体积达数百 MB。
# 目录由 `ASR_MODEL_DIR` 决定（默认 <数据目录>/models/whisper），
# 开发形态下即 backend/models/whisper/。
backend/models/

# ===== 本地私有资料（自备 SDK/模型包、开发留档、旧备份、生成缓存）=====
# 与源码无关但需要留在本机的文件统一放这里，保证根目录只出现项目本身
_local/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===== pi 本地会话记录（含对话隐私，不提交）=====
.pi-web/

# ===== 里程碑总结留档（本地开发过程记录，不入库）=====
summaries/

# ---- Live2D / Cubism SDK 与模型（自备资源，不入库）----
# Cubism SDK for Web（Core + Framework + Shaders）由 scripts/setup-cubism.mjs 落位
frontend/vendor/cubism/
frontend/public/vendor/cubism/
# 模型资源：只有能自由分发的才可放开例外
frontend/public/live2d/
*.moc3
*.model3.json
*.physics3.json
*.pose3.json
*.cdi3.json
*.exp3.json
*.motion3.json

# 自备资源压缩包（Live2D SDK / 模型包等一律不入库）
*.zip

# ===== 一次性数据备份（含真实记忆与本地配置，不入库）=====
# 改动前对 data/ 的快照；memory.db 是真实对话记忆、settings.json 含本机路径，
# 属 §8.6 红线范围内的隐私数据
backend/_backup_*/

# ===== 本地生成的交付文档（PDF 等二进制产物，不入库）=====
*.pdf
