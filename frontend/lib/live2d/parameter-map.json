  "eyeLeftOpen": "ParamEyeLOpen",
  "eyeRightOpen": "ParamEyeROpen",
  "gazeX": "ParamEyeBallX",
  "gazeY": "ParamEyeBallY",
  "bodyAngle": "ParamBodyAngleX",
  "breath": "ParamBreath"
