# ===== HyPRA 后端环境变量模板 =====
# 填写位置（两种形态不同）：
#   · 源码 / docker 部署 → 复制为 backend/.env
#   · 桌面端安装包       → 首次启动会自动生成 %APPDATA%/HyPRA/.env，直接编辑它
# .env 已被 gitignore，严禁入库。
#
# 双模式说明：
#   本地开发 → 温层用云 Qdrant，模型用你自己的云 key；
#   评委评审 → docker compose 一键部署本地 Qdrant，并在 .env 填自己的
#              embedding / LLM key（provider + model 均可选）。

# ---- 基础 ----
DEBUG=false

# ---- CORS（前端跨域访问）----
# 逗号分隔的允许来源；"*" 表示允许全部（仅建议本地/内网演示）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 额外放行的正则白名单（默认：本机回环地址的任意端口，供桌面端等非固定端口的前端使用）
# 置空 = 只认上面的固定列表
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$

# ---- 冷层（本地 SQLite；默认 data/memory.db，无需改动）----
# COLD_DB_PATH=data/memory.db

# ---- 会话存储（多轮对话历史）----
# sqlite（默认）：落 SQLite —— 刷新页面、重启后端后的历史都在
# memory        ：进程内（测试/轻量场景，重启即清空）
# SESSION_BACKEND=sqlite
# 空 = 跟随冷层库文件（COLD_DB_PATH），同库不同表
# SESSION_DB_PATH=
# 历史接口一次最多返回的消息条数（界面「历史记录」用；
# 与喂给模型的热层窗口无关 —— 窗口大小固定为最近 20 条）
# SESSION_HISTORY_LIMIT=200

# ---- 记忆可调参数（影响召回范围与遗忘速度）----
# 情景记忆（对话回忆）召回条数
# MEMORY_TOP_K=3
# 语义记忆（结构化事实）召回：总数上限 = 锚点保底 + 相关性补充
# MEMORY_FACT_LIMIT=5
# 锚点保底条数（高 importance，保证「用户是谁」不因话题切换而消失）
# MEMORY_FACT_ANCHOR_N=3
# 按 query 相关性补充条数（保证当前话题接得上）
# MEMORY_FACT_RELEVANT_N=2
# 时间衰减半衰期（天）：越大越不易淡忘，M6 长周期陪伴可调到 90+
# MEMORY_HALF_LIFE_DAYS=30
# 衰减强度：0=不衰减，1=标准半衰期，>1 更强地让位于近期记忆
# MEMORY_DECAY_EXPONENT=1
# 同情绪记忆的召回加权系数（情绪联动召回）
# MEMORY_EMOTION_BOOST=1.25
# 情景记忆淘汰 TTL（天）：超过该时长未被召回的记忆会被删除。
# 必须远大于 MEMORY_HALF_LIFE_DAYS，否则会形成「衰减→不召回→被删」的正反馈
# MEMORY_RECALL_TTL_DAYS=180
# ---- 混合检索（BM25 稀疏 + 稠密向量 → RRF 融合）----
# 关闭则退化为纯向量召回（需重启生效）
# MEMORY_HYBRID_ENABLED=true
# 各通道候选条数（应远大于 MEMORY_TOP_K，否则融合退化为合并去重）
# MEMORY_CANDIDATE_N=10
# RRF 平滑常数（原论文推荐 60）
# MEMORY_RRF_K=60
# 稠密通道相似度阈值：在融合前过滤（RRF 分数无绝对含义，无法事后设阈）
# 依 embedding 模型而异，需实测校准；0 = 不过滤
# MEMORY_MIN_SIMILARITY=0
# 回复后抽取器：rule（规则版，零依赖）| llm（覆盖率与准确性更高，需 LLM key；
# 失败自动降级为规则版，不阻断对话）
# MEMORY_EXTRACTOR=rule

# ---- SillyTavern 预设兼容（导入的酒馆预设）----
# 存放目录（相对 backend 运行目录；backend/data/ 已被 gitignore 覆盖）。
# 导入的预设属**用户本地数据**：只解析与渲染，不进仓库、不随发行物分发。
# ST_PRESETS_DIR=data/presets

# ---- 创作工坊（用户自建角色卡 / 世界书条目）----
# 存放目录（相对 backend 运行目录；backend/data/ 已被 gitignore 覆盖）。
# 用户自撰内容属**本地数据**：不进仓库、不随发行物分发。
# 内置角色 / 条目只读；用户对内置条目的「停用」偏好也写在用户侧文件
# （data/studio/worldbook/disabled_builtin.json）里，内置 YAML 一字未改。
# STUDIO_DIR=data/studio

# ---- 叙事框架层（jailbreak，术语对齐 ST 的 jailbreak 槽位）----
# 声明「这段对话处在什么框架里」（虚构叙事 / 现实问答），排在内置 system 提示的最前。
#
# **默认关闭**，而且这是产品口径不是待办：本层会抑制「作为 AI 我建议你…」这类跳出
# 角色的回应、并在虚构语境内放开题材，属于「用户知情后自行开启」的能力。
# 关闭时该层为空串，提示词与不装本层时逐字一致。
#
# 预设内容与代码分离：backend/app/prompts/jailbreak/presets/*.yaml
#   immersive-narrative   沉浸叙事（默认档）：虚构语境声明 + 不跳出角色
#   strict-in-character   严格入戏：长陪伴下不重复自我介绍、不把用户当陌生人
#   mature-fiction        成熟向虚构：成年用户与虚构成年角色的前提下放开亲密描写
#
# 本层与 persona / style 正交，可任意组合；也可以在界面上开关（同一组字段，
# 界面保存的值优先于本文件，保存即生效）。
#
# ⚠️ 启用即代表你接受：本层改变了模型的回应框架。各预设末尾都写有 <boundary> 段，
# 明确框架之外仍然成立的红线（现实问题如实回答、不生成真实可执行的伤害性步骤、
# 危机信号优先）—— 修改预设时请保留这一段。
JAILBREAK_ENABLED=false
# 生效的框架预设 id；留空 = 启用时用默认档 immersive-narrative
JAILBREAK_PRESET=
# 框架块 token 预算（内置预设 550~900 字，600 足够）
# JAILBREAK_BUDGET=600

# ---- 酒馆数据接入（tavern-bridge 插件 / AGENTS.md §8 / §9.8）----
# 只读接入本地 SillyTavern 数据，插件本身绝不写入（manifest 声明 write: false）。
# 酒馆数据目录在**能力中心 → 酒馆数据接入 → 设置**里填（可填 ST 根目录，插件自动识别
# data/<profile>），不在这里配：它是插件私有配置，不进宿主 Settings。
#
# 下面这一个开关是**宿主字段**，所以能放 .env，也能被界面配置覆盖（§9.5）：
# 把酒馆世界书当作设定注入对话（worlds/*.json → WorldBookEntry）。
# 默认 false，三个理由：
#   ① 真实世界书动辄几百条，其中近一半是「常驻」型（每轮都注入），一开就吃掉整个世界书预算；
#   ② 内容是用户私有语料，默认注入等于替用户做了决定；
#   ③ 勘察数据不得作为演示素材（§8.6）——演示要另外自创。
# 打开后可用 WORLDBOOK_BUDGET 调大注入预算；角色内嵌世界书暂不接入。
TAVERN_WORLDBOOK_ENABLED=false

# 启动时把酒馆里**新增**的对话增量同步进长期记忆（默认关）。
# 同步按轮次游标做增量：已同步过的轮次不会重写，接着聊的内容下次启动会补上；
# 按角色各进各的陪伴对象（选哪个角色就只召回那个角色的上下文）。
# 后台线程执行，不阻塞启动；首次同步历史会话可能较慢。
# 不打开时，在「能力中心 → 酒馆记忆导入」面板里手动点「同步新对话」也可以。
TAVERN_SYNC_ON_STARTUP=false

# ---- 温层（向量库）----
# 评审本地 docker 填：QDRANT_URL=http://qdrant:6333（无需 key）
# 开发用云 Qdrant：填云端 URL + API key
WARM_BACKEND=memory          # memory（本地假实现，零依赖默认）| qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- 中文分词（BM25 稀疏检索通道）----
# auto（默认，jieba 可用就用，否则降级字符 bigram）| jieba（强制，未装则报错）
# | char-bigram（零依赖，CI / 离线演示）
# TOKENIZER_BACKEND=auto

# ---- 情绪兜底策略（主通道是 LLM function calling，不可换）----
# regex（默认，关键词/正则）| neutral（不判断，恒中性）
# 选 neutral 的场合：正则读不懂否定（「我不开心」会命中「开心」），
# 而情绪会驱动 3D 表情与记忆加权——宁可中性也不要判反。
# EMOTION_FALLBACK=regex

# ---- LLM（对话生成）----
# provider: mock | dashscope | siliconflow | openai-compatible
LLM_PROVIDER=mock            # 默认 mock：无 key 也可跑通链路（占位回复）
LLM_API_KEY=
LLM_MODEL=qwen2.5-7b-instruct
# openai-compatible 需填 base_url，如 https://api.example.com/v1
LLM_BASE_URL=
# 推理模型开关：qwen3 等推理模型会先生成大量思考 token（实测慢 4-5 倍）
# 情感陪伴不需要长思考，建议关闭
LLM_ENABLE_THINKING=false

# ---- 个人记忆（知识库：用户上传的私人语料）----
# 存储后端留空则**跟随温层**（WARM_BACKEND）——评审只需配一处
# KNOWLEDGE_BACKEND=
KNOWLEDGE_ENABLED=true
# 单文件大小上限（MB）
# KNOWLEDGE_MAX_FILE_MB=5
# 分块参数（字符）：target 聚合目标 / max 单块硬上限 / overlap 句级回退
# KNOWLEDGE_CHUNK_TARGET=400
# KNOWLEDGE_CHUNK_MAX=600
# KNOWLEDGE_CHUNK_OVERLAP=80
# 语义边界判据（false 则退化为纯递归字符分块）
# KNOWLEDGE_SEMANTIC_CHUNKING=true
# KNOWLEDGE_SEMANTIC_THRESHOLD=0.75
# MinHash 近似判重阈值（命中不自动覆盖，需 force=true）
# KNOWLEDGE_DEDUP_THRESHOLD=0.85

# ---- Embedding（语义向量）----
# provider: deterministic | dashscope | siliconflow | openai-compatible
# 不填 key 时用 deterministic 零依赖运行：温层向量召回与世界书向量触发会自动
# 降级（关键词/正则通道不受影响），但**语义相似度不可用**，
# 世界书 vector_threshold 这类阈值参数也会失效（两者相似度分布完全不同）。
#
# 这一段也可在界面上配：能力中心 → 文本向量化 → 详情（同一组字段，键名与这里一一对应）。
# 界面保存的值优先于本文件，且保存即生效（不必改 .env、不必重启）。
EMBEDDING_PROVIDER=deterministic   # 默认本地确定性实现，零依赖
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=
# 向量维度：必须与模型实际输出一致，不符时首次请求即报错并告知正确值
# （Qdrant collection 维度必须一致；已建库改模型需删旧 collection）
# 参考：text-embedding-v3 = 1024，BAAI/bge-m3 = 1024，
#       Qwen/Qwen3-Embedding-8B = 4096
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=30
# 编码结果 LRU 缓存条数。一轮对话会对**同一句用户输入**重复编码 4–7 次
# （世界书向量通道 + 知识库每个作用域 + 温层情景记忆），远程 embedding
# 单次 200–500ms，缓存把它们压成 1 次远程请求。
# 单条 4096 维向量在 Python 里约 130KB，64 条 ≈ 8MB。
# 改动后需重启后端（构造期读取）。
EMBEDDING_CACHE_SIZE=64

# ---- Agent 行动层（工具调用：情绪日记/趋势/呼吸引导/记忆检索/技能学习）----
AGENT_TOOLS_ENABLED=true
MAX_TOOL_ROUNDS=2

# ---- 技能体系（渐进式加载的能力说明，见 AGENTS.md §9.6）----
# 与插件体系**相互独立**：插件是「代码能力可插拔」（进程级），
# 技能是「方法论可插拔」（提示词级，本质就是一段给模型看的 Markdown）。
#
# 常驻上下文里只有清单（id / 名称 / 适用场景，几十 token），
# 正文只在模型调 study_skill 时取回——所以技能数量不影响基础开销。
#
# 放置：backend/skills/<id>/SKILL.md（内置，随项目分发）
#      或 USER_SKILLS_DIR 下同构路径（自建；data/ 已 gitignore）
# SKILL.md 头部为 YAML frontmatter：name / description / when_to_use
SKILLS_ENABLED=true
# USER_SKILLS_DIR=data/skills
# 初始禁用列表（逗号分隔）；界面上的启停会落盘并覆盖它
# SKILLS_DISABLED=

# ---- MCP（把外部 MCP server 的工具接入 Agent 行动层）----
# 清单默认取 backend/mcp_servers.json（兼容 Claude Desktop 的 mcpServers 写法，
# 支持 ${PYTHON} / ${BACKEND_DIR} 占位符）；文件不存在 = 未配置，等同不启用。
MCP_ENABLED=true
MCP_SERVERS_FILE=
MCP_CONNECT_TIMEOUT=20
MCP_CALL_TIMEOUT=30

# ---- 魔珐星云（数字人 + TTS，M5）----
# provider: local（零依赖降级，默认）| xmov（魔珐星云实时驱动 + TTS）| gpt_sovits（自部署 TTS）
#   · xmov：魔珐 SDK 同时管形象与声音，音色用下面的 XMOV_VOICE；
#   · gpt_sovits：只出声音，形象由前端渲染 Live2D / 静态立绘。
#     魔珐 SDK 的 speak() 只吃 SSML 文本、不接受外部音频，所以“魔珐形象 + GPT-SoVITS 声音”
#     当前不可行（要么用魔珐音色，要么换自研渲染）。
DIGITAL_HUMAN_PROVIDER=local
# 密钥从魔珐控制台「密钥管理」获取（评审时由评委自行填入）
XMOV_APP_ID=
XMOV_SECRET=
XMOV_VOICE=XMOV_LV_TTS__13
XMOV_HOST=nebula-agent.xingyun3d.com
# 是否在 /chat 后附带数字人驱动数据
AVATAR_ENABLED=true

# ---- GPT-SoVITS（自部署 TTS：给 Live2D / 静态立绘出真声音）----
# 启用方式：把上面 DIGITAL_HUMAN_PROVIDER 改成 gpt_sovits（不另设第二个 TTS 开关，
# 避免两个配置项打架）。**服务未部署时无需改动任何配置**：驱动会自动降级为
# 无音频（has_audio=false），前端据此回落浏览器原生 TTS，对话不中断。
#
# 服务地址与音色这一段也可在界面上配：能力中心 → 语音合成 → 详情（同一组字段）。
# 界面保存的值优先于本文件，且保存即生效。注意「要不要用服务端语音」仍由上面的
# DIGITAL_HUMAN_PROVIDER 决定——界面里**不重复**放一个开关。
#
# 启动服务（官方仓库，默认端口 9880，需要 GPU；
# 详见 docs/deployment.md）：
#   python api_v2.py -a 127.0.0.1 -p 9880 -c GPT_SoVITS/configs/tts_infer.yaml
GPT_SOVITS_BASE_URL=http://127.0.0.1:9880
# 音色 = 参考音频 + 这段音频对应的文字（零样本克隆，5 秒左右即可）。
# 注意：这里填**跑 GPT-SoVITS 那台机器**上可见的路径，不是本机相对路径。
GPT_SOVITS_REF_AUDIO=
GPT_SOVITS_PROMPT_TEXT=
GPT_SOVITS_PROMPT_LANG=zh
GPT_SOVITS_TEXT_LANG=zh
GPT_SOVITS_SPEED=1.0
# 输出容器：wav（推荐，浏览器可直接播放）| ogg | aac | raw
# raw 是裸 PCM，<audio> 放不了，别选。
GPT_SOVITS_MEDIA_TYPE=wav
GPT_SOVITS_TIMEOUT=60
# 额外请求参数（一行 JSON，原样透传给 GPT-SoVITS 的 /tts，用于调优；留空 = 用服务端默认）。
# 实测例子：{"parallel_infer": false}（略快）。核心字段（text/ref_audio_path/media_type 等）不可覆盖。
GPT_SOVITS_EXTRA_PARAMS=
# 启动时后台预热一次（让模型/显存预热，首个请求不偏慢）；失败只记日志
GPT_SOVITS_WARMUP=true
# 音色表（可多套音色）：JSON 文件，键 = 音色 id（前端 voice 字段传的值），值为
#   {"ref_audio_path": "refs/gentle.wav", "prompt_text": "今天也辛苦了。", "label": "温柔"}
# 参考音频必须 **3~10 秒**（GPT-SoVITS 服务端会硬校验）；prompt_text 与音频内容一致时
# 相似度最佳，**留空也能用**（实测可正常合成，速度更快、相似度略降）。
# 文件不存在 = 只用默认音色。属于**用户本地数据**（backend/data/ 已被 .gitignore 覆盖）。
# 保留键 "_emotion_map" = 情绪→音色：不指定 voice 时按本轮情绪选声音，例如
#   "_emotion_map": {"sad": "sad", "tired": "sad", "happy": "joyful", "calm": "neutral"}
GPT_SOVITS_VOICES_FILE=data/tts_voices.json
# 不指定 voice 时用哪个音色 id（空 = 用默认参考音频）
GPT_SOVITS_DEFAULT_VOICE=

# 数字人模型库：上传的 Live2D 模型包 / 静态立绘落在这里（默认 backend/data/avatar_models，
# 已被 .gitignore 覆盖）。前端通过 /media/avatar/models/* 上传与取用，不写 frontend/public。
# 评委验收时无需预置模型：在页面「数字人设置 → 模型库」里上传即可。
AVATAR_MODELS_DIR=data/avatar_models

# 数字人模型清单（可选）：本地 JSON 文件路径（也接受 file:// URL）。
# 用途：把「还有哪些模型可以获取」展示给用户（含作者 / 授权 / 获取地址）——
# 模型不可自由分发，本项目**不代下载**，只给链接。
# 不填也能用：模型库照常显示已装的模型，只是没有「可获取」列表。
# 格式见 backend/plugins/live2d-model-source/model-manifest.example.json。
# 只支持本地路径：拉远程 JSON 是网络访问，而插件权限模型目前只对文件系统
# 有强制校验，声明 network.hosts 为空却真去发请求等于把声明写成空话。
# LIVE2D_MANIFEST_PATH=


# =============================================================
# 插件（自己写的插件放哪 / 从哪扫）
# =============================================================
#
# 插件由**你自己写**：一个目录 = 一个插件，里面是 manifest.json（声明）+ plugin.py（入口）。
# 完整接口见 docs/plugin-development.md，可复制的最小示例见 docs/examples/plugin-hello/。
#
# 两条接入路径：
#
# 1) 用户插件目录（默认 backend/data/plugins，已被 .gitignore 覆盖）
#    把插件目录丢进去，然后在「能力中心 → 添加插件」点「重新扫描」，不必重启。
#    PLUGINS_DIR=data/plugins
#
# 2) 额外来源目录（逗号分隔）——**开发期推荐**：插件留在你自己的仓库 / 工作区里，
#    宿主直接扫它，改完代码点一次「重新扫描」即可，宿主不碰你的源文件。
#    绝对路径原样使用；相对路径按数据目录（data/）解析。
#    PLUGIN_EXTRA_DIRS=D:/my-plugins,../hypra-plugins
#
# 注：插件代码在宿主进程内执行、**没有沙箱**（AGENTS.md §8.5 / §9.7）。
# 权限声明（manifest.permissions）是宿主强制的架构约束，但它约束的是「拿不拿得到句柄」，
# 不是「这段代码可不可信」——装插件 = 信任它的作者。


# =============================================================
# 感知层：语音识别 / 图片理解 / 桌面情景
# 设计见 docs/proactive-multimodal.md §4
# =============================================================
#
# 总口径：**感知默认全关、逐项显式开启**。与插件「默认启用」刻意不同——
# 插件是功能，感知是隐私。

# ---- 语音识别（ASR）----
# 这个字段**本身就是开关**（与 DIGITAL_HUMAN_PROVIDER 同一口径）：
#   none            = 关闭（默认）。界面不渲染麦克风
#   faster-whisper  = 本地识别
ASR_PROVIDER=none
# 本地识别需要先在后端环境执行：pip install faster-whisper
# 模型权重**不进发布包**（AGENTS.md §3.2 的同一条原则），由用户自备：
#   把模型放到 <数据目录>/models/whisper/<规格>/（该目录下应有 model.bin 等文件）
# 数据目录：开发形态是 backend/，安装包形态是 %APPDATA%/HyPRA/
ASR_MODEL=small
ASR_MODEL_DIR=models/whisper
# 允许 faster-whisper 自己下载权重时的落点。**默认空 = 不自动下载**——
# 静默拉 1GB 权重既慢又常失败（国内网络），且用户不知道机器上在发生什么。
ASR_DOWNLOAD_ROOT=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
# 用 Silero VAD 先切掉非语音段。**建议保持开启**，而且这不是调优是正确性：
# Whisper 在没人声的音频上会吐出训练集水印（实测 small 模型 + 纯音 → 「字幕by索兰娅」），
# 而那会被当成用户说的话填进输入框。
ASR_VAD_FILTER=true
# 无语音判定阈值（0-1，越大越容易判成「没人说话」）。与 VAD 构成两道防线，
# 漏网的由 provider 里的文本过滤兜住。
ASR_NO_SPEECH_THRESHOLD=0.6
# 是否在对话界面显示语音按钮。关掉后**能力仍在**（快捷键照常可用），
# 只是不再渲染那个按钮——给「用快捷键说话、不想看见按钮」的人留的开关。
ASR_UI_ENABLED=true
# 语音快捷键（形如 Ctrl+Shift+M；留空 = 不启用）。
# 按一下开始录音、再按一下结束，等价于点按钮。只在窗口获得焦点时生效——
# 不注册系统级全局热键，那会与你的其它软件抢键。
ASR_SHORTCUT=
# 启动时后台预热一次（加载模型，让第一次说话不必等十几秒）；失败只记日志
ASR_WARMUP=true

# ---- 图片理解（Qwen2.5-VL）----
# **只做「用户主动分享」**：摄像头与连续屏幕感知已明确否决（隐私成本远高于收益）。
#   none               = 关闭（默认）。界面不渲染「发图」入口
#   openai-compatible  = 走 OpenAI 兼容端点（零新依赖，openai SDK 已在本项目里）
#   dashscope / siliconflow = 同上，并自动取该家的默认端点——只填 Key 即可
VISION_PROVIDER=none
VISION_API_KEY=
VISION_MODEL=qwen2.5-vl-72b-instruct
# 留空 = 按 provider 取默认端点
VISION_BASE_URL=
VISION_TIMEOUT=60
# 图片以 data URL 内联进请求、**不落盘**；上限防止一次传进过大的图
VISION_MAX_IMAGE_MB=8
# 描述指令（留空 = 用内置的「只描述看得见的」客观描述指令）。
# 不建议改成让模型推断情绪——推断是人设的职责，感知层只该提供素材。
VISION_PROMPT=
# 是否在对话界面显示「图片」按钮（关掉后接口仍可用，只是不渲染入口）
VISION_UI_ENABLED=true

# ---- 桌面情景（只由 Electron 桌宠端采集，Web 端拿不到）----
# 是否接收桌宠端上报的「正在听的歌 / 前台窗口 / 空闲 / 电量 / 时段」。
# 关掉后**采集链路立即停止**，已有数据也会被清掉。
PERCEPTION_DESKTOP_ENABLED=true
# 是否把**前台窗口标题**注入提示词。默认 false：
# 歌名是用户主动播放的、可以聊；窗口标题可能是一封邮件或一个病历页面。
# （窗口的**进程名**始终会采集，它是「忙碌判定」必需的，但不进提示词。）
PERCEPTION_INCLUDE_WINDOW_TITLE=false
# 感知层（「此刻」）的 token 预算。行踪与画像进来之后默认 200——
# 那两行是主动开口「有由头」的来源，被裁掉就退化成空泛问候了。
PERCEPTION_BUDGET=200

# ---- 时间感（设计见 docs/proactive-multimodal.md §4.8）----
# 是否把「现在几点 / 星期几 / 什么时段」告诉角色。**默认开**：
# 这是对话里最基础的一条上下文，而它原先只在桌面情景上报里才有
# （Web 端完全没有、桌宠窗关着也没有）。
# 来源：客户端在线时用它的墙上的钟（容器部署时后端可能在 UTC），
# 否则回落服务端本地时间——两条来源渲染成同一个格式。
PERCEPTION_INCLUDE_TIME=true

# ---- 行踪与偏好画像（设计见 docs/proactive-multimodal.md §4.9）----
# 是否记录并注入「主人最近在电脑上干什么」。**默认只记程序名**。
# 关掉后采集立即停止，已记录的内容也会被清掉。
PERCEPTION_ACTIVITY_ENABLED=true
# 「最近在做什么」的回看窗口（小时）。默认 3
PERCEPTION_ACTIVITY_RECENT_HOURS=3
# 行踪保留天数。**刻意短**：行踪是敏感数据，够用就好。默认 7
PERCEPTION_ACTIVITY_RETENTION_DAYS=7
# 行踪里是否连**窗口标题**一起记。默认 false——标题是内容
# （可能是一封邮件、一个病历页面），程序名才是类别。
PERCEPTION_ACTIVITY_INCLUDE_TITLE=false
# 空闲多少秒算「人不在」并断开当前这一段。默认 300：
# 接个电话、去倒杯水不会断开，真的离开一定会断开。
# **调太大会记出「连续几小时在用同一个软件」**——那正是行踪最不能出的错。
PERCEPTION_ACTIVITY_IDLE_GAP_SECONDS=300
# 同一程序最长连续算一段（小时）。默认 4，让「上午 / 下午」可分辨。
PERCEPTION_ACTIVITY_MAX_SEGMENT_HOURS=4
# 是否注入偏好画像（常用程序 / 活跃时段 / 深夜占比）。
# 刻意是**确定性计数**而非模型总结：可解释、零成本、不越界。
PERCEPTION_PROFILE_ENABLED=true
# 画像回看天数。默认 7
PERCEPTION_PROFILE_DAYS=7
# 产出画像所需的最小累计时长（分钟）。默认 30——
# 用两分钟的行踪说「他最常用 Code.exe」是不诚实的。
PERCEPTION_PROFILE_MIN_MINUTES=30


# =============================================================
# 主动链路：会自己开口
# 设计见 docs/proactive-multimodal.md §5
# =============================================================
#
# 已决策：**默认开**。但这个「开」的完整含义是——
# 下面几条闸门（免打扰 / 冷却 / 配额 / 对话中不插话）**同时默认生效**。
# 用户什么都不设，体验已经是收敛的。
PROACTIVE_ENABLED=true
# 调度轮询间隔（秒）。主动开口的时间精度要求是「分钟级」，更密只会让日志变吵
PROACTIVE_INTERVAL_SECONDS=60
# 闸门②：免打扰时段（HH:MM-HH:MM，支持跨零点）
PROACTIVE_QUIET_HOURS=23:00-08:00
# 闸门②豁免：**关怀型**触发（深夜还在活动 / 电量告急）可否越过免打扰。
# 免打扰的目的是「别吵醒睡着的人」，不是「看着你熬夜也不说话」。
PROACTIVE_QUIET_EXEMPT_CARE=true
# 闸门③：两条主动消息的最小间隔（分钟）。默认 30——仍能保证「不会连着两句」；
# 想要更安静就调大（如 90），想要更活跃可调小。
PROACTIVE_MIN_INTERVAL_MINUTES=30
# 闸门④：每日主动消息上限。默认 12（约清醒时段每 1~1.5 小时一次）。
# 真正防轰炸的是闸门③与闸门⑤，不是这个上限。
PROACTIVE_DAILY_QUOTA=12
# 闸门⑤：用户刚说过话（< N 分钟）时不主动——此时该**回应**，不该另起话头
PROACTIVE_CONVERSATION_WINDOW_MINUTES=2
# 定时触发器：每天这个时刻开口（留空 = 关闭该触发器）
PROACTIVE_DAILY_TIME=09:00
# 间隔触发器：用户静默超过这么多小时就问一句（<= 0 = 关闭该触发器）
PROACTIVE_IDLE_HOURS=3
# 记忆到期触发器：进行中的事项搁置超过这么多天就回头问一句
# （「你上次说在准备面试，后来怎么样了？」）。<= 0 = 关闭该触发器。
# 同一件事只问一次——问两遍是唠叨。
PROACTIVE_MEMORY_FOLLOWUP_DAYS=3
# 行踪触发器①「久别回来」：用户离开超过这么多分钟后回到电脑前，可以打个招呼。
# 默认 30——够区分「去倒杯水」与「出门了一趟」。<= 0 = 关闭。
# **依赖「行踪」**：PERCEPTION_ACTIVITY_ENABLED=false 时它自动失效。
PROACTIVE_BACK_FROM_AWAY_MINUTES=30
# 行踪触发器②「忙完了」：从写代码 / 文档 / 设计切到游戏 / 看片，
# 且新的一段已经持续这么多分钟，就问一句。默认 20——短于它可能只是切过去看一眼。
# <= 0 = 关闭。**只做「做事→放松」一个方向**：反方向正是用户要进入状态的时候。
PROACTIVE_ACTIVITY_SHIFT_MINUTES=20
# 主动开口的字数上限（比 REPLY_CHAR_LIMIT 更短：搭话不该是一段独白）
PROACTIVE_REPLY_CHAR_LIMIT=60
# 节流状态落盘位置（原子写；文件损坏按「从未主动开口」处理）
PROACTIVE_STATE_PATH=data/proactive-state.json
# 主动开口面向哪个陪伴对象。**留空 = 用当前偏好里的角色**
PROACTIVE_PERSONA_ID=

